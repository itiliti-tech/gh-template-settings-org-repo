# Retain windows line-endings in case checked out on mac or linux
* text eol=crlf

# Explicitly declare text files
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.ps1xml text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Shell scripts need LF
*.sh     text eol=lf

# Binary files
*.exe    -text
*.dll    -text
*.zip    -text
*.7z     -text
*.tar    -text
*.gz     -text
*.png    -text
*.jpg    -text
*.jpeg   -text
*.gif    -text
*.ico    -text

# Don't diff or merge these
*.exe    -diff -merge
*.dll    -diff -merge
*.zip    -diff -merge

# Export ignore
.gitattributes export-ignore
.gitignore     export-ignore
.editorconfig  export-ignore
PSScriptAnalyzerSettings.psd1 export-ignore